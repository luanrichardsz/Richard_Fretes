<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="romaneio_carga"
    language="java"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="802"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="b7c4d42e-1111-4444-9999-000000000001">

    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>

    <parameter name="CLIENTE_ID" class="java.lang.Integer"/>

    <queryString language="SQL">
        <![CDATA[
SELECT
    frete."id" AS frete_id,
    frete."numero_frete" AS numero_frete,

    motorista."id" AS motorista_id,
    motorista."nome_completo" AS motorista_nome,
    motorista."cpf" AS motorista_cpf,
    motorista."telefone" AS motorista_telefone,

    veiculo."id" AS veiculo_id,
    veiculo."placa" AS veiculo_placa,

    remetente."id" AS remetente_id,
    remetente."razao_social" AS remetente_razao_social,
    remetente."documento" AS remetente_documento,

    destinatario."id" AS destinatario_id,
    destinatario."razao_social" AS destinatario_razao_social,
    destinatario."documento" AS destinatario_documento,

    destino."id" AS destino_id,
    destino."logradouro" AS destino_logradouro,
    destino."numero" AS destino_numero,
    destino."bairro" AS destino_bairro,
    destino."municipio" AS destino_cidade,
    destino."uf" AS destino_uf,
    destino."cep" AS destino_cep,

    (
        COALESCE(destino."logradouro", '') ||
        CASE
            WHEN destino."numero" IS NOT NULL AND destino."numero" <> ''
            THEN ', ' || destino."numero"
            ELSE ''
        END ||
        CASE
            WHEN destino."bairro" IS NOT NULL AND destino."bairro" <> ''
            THEN ' - ' || destino."bairro"
            ELSE ''
        END ||
        CASE
            WHEN destino."municipio" IS NOT NULL AND destino."municipio" <> ''
            THEN ' - ' || destino."municipio"
            ELSE ''
        END ||
        CASE
            WHEN destino."uf" IS NOT NULL AND destino."uf" <> ''
            THEN '/' || destino."uf"
            ELSE ''
        END
    ) AS destino_completo,

    frete."chave_nfe" AS chave_nfe,
    frete."natureza_carga" AS natureza_carga,
    frete."peso_bruto" AS peso_bruto,
    frete."volumes" AS volumes,
    frete."distancia_km" AS distancia_km,
    frete."valor_total" AS valor_total,
    frete."status" AS status,
    frete."data_emissao" AS data_emissao,
    frete."data_saida" AS data_saida,
    frete."previsao_entrega" AS previsao_entrega

FROM
    public."frete" frete

INNER JOIN public."motorista" motorista
    ON motorista."id" = frete."motorista_id"

INNER JOIN public."veiculo" veiculo
    ON veiculo."id" = frete."veiculo_id"

INNER JOIN public."cliente" remetente
    ON remetente."id" = frete."remetente_id"

INNER JOIN public."cliente" destinatario
    ON destinatario."id" = frete."destinatario_id"

INNER JOIN public."endereco" destino
    ON destino."id" = frete."endereco_destino_id"

WHERE
    frete."status" NOT IN ('ENTREGUE', 'CANCELADO')
    AND (
        $P{CLIENTE_ID} IS NULL
        OR frete."remetente_id" = $P{CLIENTE_ID}
        OR frete."destinatario_id" = $P{CLIENTE_ID}
    )

ORDER BY
    motorista."nome_completo",
    frete."data_saida",
    destino."municipio",
    destinatario."razao_social",
    frete."numero_frete"
        ]]>
    </queryString>

