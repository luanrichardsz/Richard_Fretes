<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="manutencoes_veiculos"
    language="java"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    whenNoDataType="NoDataSection"
    columnWidth="802"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="d11c6b11-4f37-4d76-88c8-aec53d900001">

    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>

    <parameter name="CLIENTE_ID" class="java.lang.Integer"/>
    <parameter name="STATUS_MANUTENCAO" class="java.lang.String"/>

    <queryString language="SQL">
        <![CDATA[
SELECT
    mv.id AS manutencao_id,
    c.razao_social AS cliente_razao_social,
    v.placa AS veiculo_placa,
    v.tipo AS veiculo_tipo,
    CAST(v.status AS VARCHAR) AS veiculo_status,
    CAST(mv.tipo AS VARCHAR) AS manutencao_tipo,
    CAST(mv.status AS VARCHAR) AS manutencao_status,
    mv.descricao AS manutencao_descricao,
    mv.data_prevista AS manutencao_data_prevista,
    mv.data_realizacao AS manutencao_data_realizacao,
    mv.custo AS manutencao_custo,
    mv.fornecedor_oficina AS manutencao_fornecedor,
    mv.observacao AS manutencao_observacao,
    mv.adicionado_em AS manutencao_adicionado_em
FROM
    public.manutencao_veiculo mv
INNER JOIN public.veiculo v
    ON v.id = mv.veiculo_id
LEFT JOIN public.cliente c
    ON c.id = v.cliente_id
WHERE
    ($P{CLIENTE_ID} IS NULL OR v.cliente_id = $P{CLIENTE_ID})
    AND ($P{STATUS_MANUTENCAO} IS NULL OR CAST(mv.status AS VARCHAR) = $P{STATUS_MANUTENCAO})
ORDER BY
    c.razao_social,
    v.placa,
    mv.data_prevista DESC,
    mv.adicionado_em DESC
        ]]>
    </queryString>

    <field name="manutencao_id" class="java.lang.Integer"/>
    <field name="cliente_razao_social" class="java.lang.String"/>
    <field name="veiculo_placa" class="java.lang.String"/>
    <field name="veiculo_tipo" class="java.lang.String"/>
    <field name="veiculo_status" class="java.lang.String"/>
    <field name="manutencao_tipo" class="java.lang.String"/>
    <field name="manutencao_status" class="java.lang.String"/>
    <field name="manutencao_descricao" class="java.lang.String"/>
    <field name="manutencao_data_prevista" class="java.sql.Date"/>
    <field name="manutencao_data_realizacao" class="java.sql.Date"/>
    <field name="manutencao_custo" class="java.math.BigDecimal"/>
    <field name="manutencao_fornecedor" class="java.lang.String"/>
    <field name="manutencao_observacao" class="java.lang.String"/>
    <field name="manutencao_adicionado_em" class="java.sql.Timestamp"/>

    <variable name="total_registros" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{manutencao_id}]]></variableExpression>
    </variable>

    <variable name="total_custo" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{manutencao_custo}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

